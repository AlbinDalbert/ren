---
import { site } from '../data/site'

const path = Astro.url.pathname
const links = [
  { href: '/', label: 'Index' },
  { href: '/work', label: 'Work' },
  { href: '/notes', label: 'Notes' },
  { href: '/about', label: 'About' },
]

const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href)
---

<header class="site-header">
  <a class="identity" href="/" aria-label={`${site.name}, home`}>
    <span class="identity-mark" aria-hidden="true">{site.shortName}</span>
    <span class="identity-copy">
      <strong>{site.name}</strong>
      <small>Personal index</small>
    </span>
  </a>

  <nav class="primary-nav" aria-label="Primary navigation">
    {links.map((link, index) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
        <span aria-hidden="true">0{index + 1}</span>{link.label}
      </a>
    ))}
  </nav>
</header>
