---
import { site } from '../data/site'
const path = Astro.url.pathname
const links = [{ href: '/work', label: 'Work' }, { href: '/notes', label: 'Notes' }, { href: '/about', label: 'About' }]
---
<header class="site-header">
  <a class="identity" href="/" aria-label={`${site.name}, home`}><span class="identity-mark" aria-hidden="true">ad.</span><span>{site.name}</span></a>
  <nav class="primary-nav" aria-label="Primary navigation">
    {links.map(link => <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}
    <a class="github-link" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
  </nav>
</header>
