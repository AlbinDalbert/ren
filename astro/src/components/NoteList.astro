---
import type { CollectionEntry } from 'astro:content'

interface Props {
  notes: CollectionEntry<'notes'>[]
  limit?: number
}

const { notes, limit } = Astro.props
const visible = typeof limit === 'number' ? notes.slice(0, limit) : notes
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC'
})
---

<div class="note-list">
  {visible.map((note, index) => (
    <a class="note-row" href={`/notes/${note.id}/`}>
      <span class="note-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <h3>{note.data.title}</h3>
        <p>{note.data.description}</p>
      </div>
      <time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time>
      <span class="note-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>
