---
import { getCollection, render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

export const getStaticPaths = (async () => {
  const notes = await getCollection('notes', ({ data }) => !data.draft)
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }))
}) satisfies GetStaticPaths

const { note } = Astro.props
const { Content } = await render(note)
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', {
  day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC'
})
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <article class="article-shell">
    <div class="article-document">
      <div class="article-topline">
        <a href="/notes">← Notes</a>
        <div>
          <time datetime={note.data.published.toISOString()}>{formatDate(note.data.published)}</time>
          {note.data.tags.length > 0 && <span>{note.data.tags.join(' · ')}</span>}
        </div>
      </div>

      <header class="article-header">
        <h1>{note.data.title}</h1>
        <p>{note.data.description}</p>
      </header>
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
